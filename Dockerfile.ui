FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

# The API is published on the host's port 8000, so the UI reaches it through
# the host rather than a docker network. Override with -e for other setups.
ENV API_BASE_URL=http://host.docker.internal:8000

WORKDIR /app

COPY ui/requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

COPY ui/ ./ui/

EXPOSE 8501
CMD ["streamlit", "run", "ui/app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true"]
