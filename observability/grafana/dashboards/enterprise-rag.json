{
  "title": "Enterprise RAG \u2014 service",
  "uid": "enterprise-rag",
  "tags": [
    "rag",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prom",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total requests (range)",
      "id": 2,
      "description": "Windowed on purpose: counters reset when the container restarts, and increase() corrects for that. There is no honest lifetime total in Prometheus \u2014 query_history in Postgres is your system of record.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requests, last 24h",
      "id": 3,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count[24h]))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "id": 4,
      "description": "5xx only. A degraded answer is an HTTP 200 and never appears here \u2014 see the next panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_duration_milliseconds_count[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Degraded answers",
      "id": 5,
      "description": "Answers returned with degraded=true. HTTP 200s, invisible to error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "100 * sum(rate(rag_answers_total{degraded=\"true\"}[$__rate_interval])) / clamp_min(sum(rate(rag_answers_total[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Generation slots in use",
      "id": 6,
      "description": "Out of API_MAX_CONCURRENT_GENERATIONS (2). Sitting at the cap means requests are queueing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rag_generation_active)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Queue rejections (range)",
      "id": 7,
      "description": "503s from API_GENERATION_QUEUE_TIMEOUT. User-visible, and indistinguishable from a backend failure in the error-rate panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(rag_generation_rejected_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Traffic",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per day",
      "id": 9,
      "description": "Set the range to 7d or 30d to get one bar per day.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count[1d]))",
          "legendFormat": "requests/day",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "id": 10,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_duration_milliseconds_count[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Latency \u2014 and where it goes",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request latency",
      "id": 12,
      "description": "End to end, /health excluded. Buckets reach 300s \u2014 the SDK default stops at 10s, which would put every generation in +Inf.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket[$__rate_interval]))) / 1000",
          "legendFormat": "p50",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket[$__rate_interval]))) / 1000",
          "legendFormat": "p95",
          "refId": "B",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket[$__rate_interval]))) / 1000",
          "legendFormat": "p99",
          "refId": "C",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Retrieval vs generation (p95)",
      "id": 13,
      "description": "One client histogram split by host: Qdrant is retrieval, :11434 is Ollama. If your labels read server_address instead of net_peer_name, you have opted into stable semconv \u2014 swap the label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, net_peer_name) (rate(http_client_duration_milliseconds_bucket[$__rate_interval]))) / 1000",
          "legendFormat": "{{net_peer_name}}",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Generation queue wait",
      "id": 14,
      "description": "Time blocked on the 2-slot semaphore. This plus generation latency explains a complaint that neither explains alone.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_generation_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 wait",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "expr": "sum(rate(rag_generation_queue_wait_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(rag_generation_queue_wait_seconds_count[$__rate_interval])), 1e-9)",
          "legendFormat": "mean wait",
          "refId": "B",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Dependency health",
      "id": 15,
      "description": "1 = usable. recheck_failed() self-heals silently, so a dip here is the only visible sign of a flap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "rag_component_ready",
          "legendFormat": "{{component}}",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Retrieval quality and agent",
      "id": 16,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Sources returned per answer",
      "id": 17,
      "description": "Retrieval returning nothing is a fast, successful, useless request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(rag_retrieval_sources_sum[$__rate_interval])) / clamp_min(sum(rate(rag_retrieval_sources_count[$__rate_interval])), 1e-9)",
          "legendFormat": "mean sources",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Zero-source answers",
      "id": 18,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "expr": "100 * sum(rate(rag_retrieval_sources_bucket{le=\"0\"}[$__rate_interval])) / clamp_min(sum(rate(rag_retrieval_sources_count[$__rate_interval])), 1e-9)",
          "legendFormat": "% with 0 sources",
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Agent tool calls (range)",
      "id": 19,
      "description": "_prefetch is the automatic knowledge-base pre-search; the others are what the model chose.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "targets": [
        {
