# Copy to .env and fill in. .env is gitignored; this file is not.
# Load it however you prefer — `export $(cat .env | xargs)`, python-dotenv,
# or your IDE's env-file support.

# ---- Qdrant ----
# The URL is not secret. The API key is; get_client() refuses to start without it.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=RAG-hybrid-search

# ---- Ollama ----
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# ---- Postgres (query history + the SQL agent) ----
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=RAG
PG_USER=postgres
PG_PASSWORD=
