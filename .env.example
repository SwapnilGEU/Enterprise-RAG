# Copy to .env and fill in. .env is gitignored; THIS FILE IS COMMITTED, so it
# must never contain a real value. Placeholders only.
#
# Load it however you prefer — `export $(cat .env | xargs)`, python-dotenv,
# or your IDE's env-file support. The API loads it automatically if present.

# ---- Qdrant (required) ----
# Neither has a default. src/config.py::missing_settings() reports blanks at
# startup, and the API surfaces them on /ready rather than failing on the first
# search with an opaque 403.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=RAG-hybrid-search

# ---- Ollama ----
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# ---- Postgres (query history + the SQL agent) ----
# Only needed for /agent and query-history logging. /query serves without it.
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=RAG
PG_USER=postgres
PG_PASSWORD=

# ---- Gemini (evaluation judge only — not needed to serve) ----
# mlflow/ragflow.py and agentflow.py --judge-answers. Retrieval metrics
# (mlflow/retrievalflow.py) and agentflow's ToolCorrectness need no judge.
GEMINI_API_KEY=

# ---- API ----
# API_ENABLE_AGENT=false turns off /agent entirely, so Postgres, langgraph and
# langchain_community are never imported. Useful for a retrieval-only image.
API_ENABLE_AGENT=true
API_WARMUP=true
API_MAX_CONCURRENT_GENERATIONS=2
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=enterprise-rag-api

# ---- OpenTelemetry — traces to Tempo --------------------------------------
# Unset means tracing is off and the service behaves exactly as before.
#
# PORT IS NOT FREE CHOICE. The exporter defaults to gRPC, which is 4317.
# 4318 is the HTTP port and needs the protocol line below set as well; pointing
# a gRPC exporter at 4318 fails at export time, not at startup.
#
# THESE DO NOT GO IN THIS FILE. See api/.env.example.
#
# mlflow/ragflow.py, agentflow.py and retrievalflow.py all load this very .env
# (PROJECT_ROOT first). MLflow treats a configured OTLP endpoint as EXCLUSIVE,
# so an endpoint here would make an EVAL run ship its trace to the collector
# instead of to MLflow — leaving DeepEval with no retrieval_context and no
# tools_called, and every scorer reporting "N/N failed" with no hint why.
#
# api/main.py loads api/.env as well as this file; the eval flows do not. So
# serving-only telemetry config lives there:
#
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # lgtm:4317 in compose
#     OTEL_SERVICE_NAME=enterprise-rag-api
#
# Under docker compose, docker-compose.yml sets them on the api service and
# neither file is involved.

# ---- MLflow and OTel do not share a trace ---------------------------------
# Measured on mlflow 3.16.1: @mlflow.trace spans get their OWN trace_id and
# parent=None, and never reach the global OTel provider. MLflow keeps a
# separate TracerProvider. So the two produce two unrelated traces, and leaving
# MLflow tracing on in the serving path would put orphan single-span traces
# into Tempo AND keep writing rows into mlflow.db on every request (which is
# what currently raises the mlflow-artifacts URI warning).
#
# Serving: off. api/observability.py calls mlflow.tracing.disable() itself once
# tracing is configured, so there is deliberately NO MLFLOW_TRACING_ENABLED line
# in this file. Putting one here would be a trap: mlflow/ragflow.py loads this
# very .env (PROJECT_ROOT first), so a `false` here would disable tracing during
# EVAL runs too — and DeepEval reads retrieval_context off the MLflow trace, so
# all four scorers would fail with the same uninformative "N/N failed".
# docker-compose.yml sets it on the api service only, where the blast radius is
# one container.
#
# Eval runs are the opposite and need no change here: mlflow/*.py set
# MLFLOW_TRACKING_URI (default http://127.0.0.1:5000) and must NOT see an OTLP
# endpoint — MLflow treats one as EXCLUSIVE and would send the trace to the
# collector instead of to MLflow, leaving DeepEval with no retrieval_context
# and no tools_called, reported as the same "N/N failed" a spent judge quota
# gives. Set MLFLOW_TRACE_ENABLE_OTLP_DUAL_EXPORT=true only if you want both.
