FROM python:3.11-slim

# Without this, logs sit in a buffer and `docker logs` looks empty.
ENV PYTHONUNBUFFERED=1

# Container defaults. On the host these are localhost; from inside a container
# localhost is the container itself, so they point back at the host machine.
# Baked in so `docker run` stays short. Override with -e if you ever need to.
ENV PG_HOST=host.docker.internal \
    OLLAMA_BASE_URL=http://host.docker.internal:11434

WORKDIR /app

COPY requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt

COPY src/ ./src/
COPY api/ ./api/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
